NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Контакты менеджера. Пустое значение — кнопка не показывается (тестовых номеров на сайте нет).
NEXT_PUBLIC_MANAGER_PHONE=
NEXT_PUBLIC_MANAGER_WHATSAPP=    # цифры без «+», например 79990001122
NEXT_PUBLIC_MANAGER_TELEGRAM=    # имя пользователя без «@»

# Заявки «Перезвоните мне» уходят в Telegram: создайте бота у @BotFather и узнайте chat id.
# Без них форма честно сообщает, что онлайн-заявки не подключены.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Источник каталога: local (data/seed.json, по умолчанию) или api (внешняя БД, docs/catalog-api.md)
CATALOG_SOURCE=local
CATALOG_API_URL=
CATALOG_API_TOKEN=

# Визуальный поиск: без настроек работает демо-режим (сравнение цвета и композиции в браузере).
# NEXT_PUBLIC_VISUAL_SEARCH=api включает отправку фото на /api/visual-search → VISUAL_SEARCH_API_URL (docs/visual-search.md)
NEXT_PUBLIC_VISUAL_SEARCH=
VISUAL_SEARCH_API_URL=
VISUAL_SEARCH_API_TOKEN=
